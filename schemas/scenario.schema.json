{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tbs.local/schemas/scenario.schema.json",
  "title": "TBS Scenario",
  "description": "Canonical scenario contract between the Django backend and the UE5 runtime. Version any change.",
  "type": "object",
  "required": ["schemaVersion", "meta", "terrain", "environment", "entities", "objectives"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^0\\.\\d+\\.\\d+$" },
    "meta": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "author": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "terrain": {
      "type": "object",
      "required": ["bbox", "epsg", "source"],
      "properties": {
        "bbox": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 4,
          "maxItems": 4,
          "description": "[minLon, minLat, maxLon, maxLat] in WGS84"
        },
        "epsg": { "type": "integer", "enum": [4326] },
        "resolutionMeters": { "type": "number", "exclusiveMinimum": 0 },
        "source": {
          "type": "object",
          "required": ["provider"],
          "properties": {
            "provider": { "type": "string", "enum": ["cesium-ion", "wmts", "local-tiles"] },
            "assetId": { "type": "integer" },
            "url": { "type": "string" },
            "provenance": { "type": "string" }
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "required": ["timeOfDay"],
      "properties": {
        "timeOfDay": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
        "weather": { "type": "string", "enum": ["clear", "overcast", "rain", "fog", "snow"] },
        "fogDensity": { "type": "number", "minimum": 0, "maximum": 1 },
        "windSpeedMs": { "type": "number", "minimum": 0 },
        "windDirectionDeg": { "type": "number", "minimum": 0, "maximum": 360 }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "side", "position"],
        "properties": {
          "id": { "type": "string", "pattern": "^ent-[a-zA-Z0-9_-]+$" },
          "kind": {
            "type": "string",
            "enum": ["infantry-soldier", "infantry-squad", "team", "spawn-point", "marker"]
          },
          "side": { "type": "string", "enum": ["blue", "red", "green", "neutral"] },
          "position": {
            "type": "object",
            "required": ["lat", "lon", "alt"],
            "properties": {
              "lat": { "type": "number", "minimum": -90, "maximum": 90 },
              "lon": { "type": "number", "minimum": -180, "maximum": 180 },
              "alt": { "type": "number" }
            }
          },
          "headingDeg": { "type": "number", "minimum": 0, "maximum": 360 },
          "composition": {
            "type": "object",
            "properties": {
              "soldiers": { "type": "integer", "minimum": 1, "maximum": 32 },
              "loadout": { "type": "string" }
            }
          },
          "waypoints": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["lat", "lon"],
              "properties": {
                "lat": { "type": "number" },
                "lon": { "type": "number" },
                "alt": { "type": "number" },
                "speedMs": { "type": "number", "minimum": 0 },
                "action": {
                  "type": "string",
                  "enum": ["move", "jog", "overwatch", "hold", "engage"]
                }
              }
            }
          }
        }
      }
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "trigger"],
        "properties": {
          "id": { "type": "string", "pattern": "^obj-[a-zA-Z0-9_-]+$" },
          "description": { "type": "string", "minLength": 1 },
          "points": { "type": "integer", "minimum": 0 },
          "trigger": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["area-clear", "reach-area", "time-limit", "eliminate-entity"]
              },
              "radius": { "type": "number", "exclusiveMinimum": 0 },
              "area": { "type": "object" },
              "entityId": { "type": "string" },
              "seconds": { "type": "integer", "exclusiveMinimum": 0 }
            }
          }
        }
      }
    }
  }
}
